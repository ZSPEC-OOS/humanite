# Copy to .env.local and fill in values — never commit .env.local

# Database (Neon, Supabase, or any Postgres — required)
DATABASE_URL=postgresql://user:password@host/dbname

# OpenAI — required for humanize and scan
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Watermark fingerprinting — generate with: openssl rand -base64 32
WATERMARK_SECRET_SALT=generate-32-random-bytes-base64-here

# RSA key pair for JWT auth — generate with: make generate-jwt-keys
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
