# Copy to .env.local and fill in values — never commit .env.local

# ── Required ──────────────────────────────────────────────────────────────────

# Postgres connection string (Neon, Supabase, or any provider)
DATABASE_URL=postgresql://user:password@host/dbname

# OpenAI — or any OpenAI-compatible provider
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for other providers
# OPENAI_MODEL=gpt-4o-mini                    # default: gpt-4o-mini

# JWT secret — any long random string, e.g.: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# ── Optional ──────────────────────────────────────────────────────────────────

# Watermark salt — defaults to a dev value if omitted
# WATERMARK_SECRET_SALT=replace-with-random-base64
